{
  "manifest_version": 3,
  "name": "X Capture Studio",
  "version": "1.0.0.2",
  "version_name": "1.0.0-rc.2",
  "description": "将 X / Twitter 帖子、长文及选中的回复导出为高清长图和保留文本的长页 PDF。无强制水印，本地生成。",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://mobile.twitter.com/*",
    "https://www.x.com/*",
    "https://*.twimg.com/*",
    "https://raw.githubusercontent.com/*",
    "https://mobile.x.com/*",
    "https://www.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Capture Studio",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://mobile.x.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
