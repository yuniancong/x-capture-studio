{
  "manifest_version": 3,
  "name": "X Capture Studio",
  "version": "1.0.0.8",
  "version_name": "1.0.0-rc.8",
  "description": "将 X / Twitter 帖文、长文及选中回复保存为高清长图、文本 PDF、TXT 或 Markdown；支持复制文本与 AI 上下文，本地处理。",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://mobile.twitter.com/*",
    "https://www.x.com/*",
    "https://*.twimg.com/*",
    "https://raw.githubusercontent.com/*",
    "https://mobile.x.com/*",
    "https://www.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Capture Studio",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://mobile.x.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "optional_permissions": [
    "webRequest"
  ],
  "minimum_chrome_version": "120"
}
